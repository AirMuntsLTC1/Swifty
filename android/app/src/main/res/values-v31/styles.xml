<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: white background and the plane as the splash icon.
     Without the splash icon, Android shows the launcher icon in a rounded box. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_plane</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/brand_white</item>
    </style>
</resources>
